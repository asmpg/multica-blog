---
import PostCard from './PostCard.astro';
import type { PublicPostSummary } from '../data/contract';

interface Props {
  posts: PublicPostSummary[];
  /** 列表的可访问名称，例如“最新文章”。 */
  label: string;
}

const { posts, label } = Astro.props;
---

<ul class="alist" aria-label={label}>
  {
    posts.map((post) => (
      <PostCard post={post} />
    ))
  }
</ul>
