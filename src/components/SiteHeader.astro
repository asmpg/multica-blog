---
import type { Site } from '../data/contract';

interface Props {
  site: Site;
  current?: 'home' | 'archive' | 'about' | null;
}

const { site, current = null } = Astro.props;

const links = [
  { key: 'home', label: '首页', href: '/' },
  { key: 'archive', label: '归档', href: '/archive' },
  { key: 'about', label: '关于', href: '/about' },
] as const;
---

<header class="site-header">
  <a class="site-brand" href="/">{site.name}</a>
  <nav class="site-nav" aria-label="站点导航">
    {
      links.map((link) => (
        <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
