---
import type { ArchivePage } from '../data/contract';

interface Props {
  archive: ArchivePage;
}

const { archive } = Astro.props;
---

<nav class="pagination" aria-label="文章分页">
  {
    archive.previousPath ? (
      <a class="chip" href={archive.previousPath} rel="prev">
        上一页
      </a>
    ) : (
      <span class="chip chip--disabled" aria-disabled="true">
        上一页
      </span>
    )
  }
  <span class="chip" aria-current="page">第 {archive.page} / {archive.totalPages} 页</span>
  {
    archive.nextPath ? (
      <a class="chip" href={archive.nextPath} rel="next">
        下一页
      </a>
    ) : (
      <span class="chip chip--disabled" aria-disabled="true">
        下一页
      </span>
    )
  }
</nav>
