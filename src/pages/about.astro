---
import BaseLayout from '../components/BaseLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import { getAbout } from '../data/contract';

const about = getAbout();
---

<BaseLayout seo={about.seo} current="about">
  <article class="article">
    <h1 class="article-title">{about.title}</h1>
    <div class="article-meta">
      <span>{about.author.name}</span>
    </div>
    <ArticleBody html={about.body} />
  </article>
</BaseLayout>
